
{
  "swagger": "2.0",
  "info": {
    "title": "Backend Analítico API",
    "description": "API REST para indicadores empresariales con SQL Server y MongoDB.",
    "version": "1.1.0"
  },
  "host": "127.0.0.1:5000",
  "basePath": "/",
  "schemes": ["http"],
  "produces": ["application/json"],
  "tags": [
    {
      "name": "Sistema",
      "description": "Servicios generales del backend."
    },
    {
      "name": "Indicadores SQL Server",
      "description": "Indicadores generados desde SQL Server."
    },
    {
      "name": "Indicadores MongoDB",
      "description": "Indicadores generados desde MongoDB."
    },
    {
      "name": "Indicadores Integrados",
      "description": "Indicadores que combinan SQL Server y MongoDB."
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Sistema"],
        "summary": "Estado del Backend",
        "responses": {
          "200": {
            "description": "Backend operativo",
            "schema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "example": "ok"
                },
                "message": {
                  "type": "string",
                  "example": "Backend Analítico operativo"
                }
              }
            }
          }
        }
      }
    },
    "/analytics/sales-total": {
      "get": {
        "tags": [
          "Indicadores SQL Server"
        ],
        "summary": "Obtener ventas totales",
        "description": "Calcula el total histórico de ventas o filtra por año (1 a 9999), mes (1 a 12) o ambos. Si solo se envía month, incluye ese mes de todos los años. Sin coincidencias devuelve data: 0. Los valores vacíos o no enteros son inválidos.\n\nPrueba en Try it out: sin valores = histórico; year=2026 = año; month=1 = enero de todos los años; year=2026 y month=1 = enero de 2026. Para comprobar HTTP 400, envía year=abc o month=15. La validación se realiza en el backend.",
        "responses": {
          "200": {
            "description": "Indicador generado correctamente",
            "schema": {
              "type": "object",
              "properties": {
                "indicator": {
                  "type": "string",
                  "example": "sales_total"
                },
                "title": {
                  "type": "string",
                  "example": "Ventas Totales"
                },
                "chart_type": {
                  "type": "string",
                  "example": "card"
                },
                "data": {
                  "type": "number",
                  "example": 5052.0
                },
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "example": [
                    "SQL Server"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Error interno del servidor"
          },
          "400": {
            "description": "Parámetros inválidos: se devuelven todos los errores de tipo o rango.",
            "schema": {
              "type": "object",
              "required": [
                "message",
                "errors"
              ],
              "properties": {
                "message": {
                  "type": "string"
                },
                "errors": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "examples": {
              "application/json": {
                "message": "Error en los parámetros enviados",
                "errors": [
                  "El año debe ser un número entero",
                  "El mes debe estar entre 1 y 12"
                ]
              }
            }
          }
        },
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "Año de las ventas: entero entre 1 y 9999. Opcional.",
            "required": false,
            "type": "string"
          },
          {
            "name": "month",
            "in": "query",
            "description": "Mes de las ventas: entero entre 1 y 12. Sin year incluye todos los años.",
            "required": false,
            "type": "string"
          }
        ],
        "operationId": "sales_total"
      }
    },

    "/analytics/products-by-category": {
      "get": {
        "tags": ["Indicadores MongoDB"],
        "summary": "Obtener productos por categoría",
        "description": "Cuenta los productos agrupados por categoría utilizando MongoDB.",
        "responses": {
          "200": {
            "description": "Productos agrupados por categoría",
            "schema": {
              "$ref": "#/definitions/ProductsByCategoryResponse"
            }
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/analytics/top-product": {
      "get": {
        "tags": ["Indicadores Integrados"],
        "summary": "Obtener producto más vendido por periodo",
        "description": "Calcula el producto con mayor cantidad de unidades vendidas en el periodo y recupera sus datos desde MongoDB. Sin filtros, consulta todos los periodos.",
        "parameters": [
          {
            "name": "year",
            "in": "query",
            "description": "Año de las ventas. El Backend valida que sea un número entero válido.",
            "required": false,
            "type": "string"
          },
          {
            "name": "month",
            "in": "query",
            "description": "Mes de las ventas. El Backend valida que esté entre 1 y 12.",
            "required": false,
            "type": "integer"
          }
        ],
        "responses": {
          "200": {
            "description": "Producto más vendido encontrado",
            "schema": {
              "$ref": "#/definitions/TopProductResponse"
            }
          },
          "400": {
            "description": "Parámetros inválidos"
          },
          "404": {
            "description": "No se encontró información del producto"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    }
  },
  "definitions": {
    "SalesTotalResponse": {
      "type": "object",
      "required": [
        "indicator",
        "title",
        "chart_type",
        "data",
        "sources"
      ],
      "properties": {
        "indicator": {
          "type": "string",
          "example": "sales_total"
        },
        "title": {
          "type": "string",
          "example": "Ventas Totales"
        },
        "chart_type": {
          "type": "string",
          "example": "card"
        },
        "data": {
          "type": "number",
          "format": "double",
          "example": 5052.0
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": ["SQL Server"]
        }
      }
    },
    "SalesByMonthResponse": {
      "type": "object",
      "required": [
        "indicator",
        "title",
        "chart_type",
        "data",
        "sources"
      ],
      "properties": {
        "indicator": {
          "type": "string",
          "example": "sales_by_month"
        },
        "title": {
          "type": "string",
          "example": "Ventas por mes"
        },
        "chart_type": {
          "type": "string",
          "example": "bar"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "example": "2026-01"
              },
              "value": {
                "type": "number",
                "format": "double",
                "example": 15000.0
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": ["SQL Server"]
        }
      }
    },
    "ProductsByCategoryResponse": {
      "type": "object",
      "required": [
        "indicator",
        "title",
        "chart_type",
        "data",
        "sources"
      ],
      "properties": {
        "indicator": {
          "type": "string",
          "example": "products_category"
        },
        "title": {
          "type": "string",
          "example": "Productos por categoría"
        },
        "chart_type": {
          "type": "string",
          "example": "bar"
        },
        "data": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "example": "Computers"
              },
              "value": {
                "type": "integer",
                "example": 20
              }
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": ["MongoDB"]
        }
      }
    },
    "TopProductResponse": {
      "type": "object",
      "required": [
        "indicator",
        "title",
        "chart_type",
        "data",
        "sources"
      ],
      "properties": {
        "indicator": {
          "type": "string",
          "example": "top_product_month"
        },
        "title": {
          "type": "string",
          "example": "Producto más vendido"
        },
        "chart_type": {
          "type": "string",
          "example": "card"
        },
        "data": {
          "type": "object",
          "properties": {
            "product_id": {
              "type": "string",
              "example": "P001"
            },
            "product": {
              "type": "string",
              "example": "Laptop HP"
            },
            "category": {
              "type": "string",
              "example": "Computadoras"
            },
            "quantity": {
              "type": "integer",
              "example": 150
            }
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "example": ["SQL Server", "MongoDB"]
        }
      }
    }
  }
}
